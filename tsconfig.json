{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "sdk/typescript/**/*.ts",
    "scripts/**/*.mjs",
    "test/**/*.mjs"
  ]
}
